---
import { getPage, getNavigation } from '../lib/api';
import Layout from '../layouts/Layout.astro';

const pathFromUrl = Astro.url.pathname || '/';
const pathFromQuery = Astro.url.searchParams.get('path');
const apiPath = pathFromQuery
  ? (pathFromQuery.startsWith('/') ? pathFromQuery : `/${pathFromQuery}`)
  : pathFromUrl;

// Paths owned by dedicated .astro pages. This catch-all route only matches a
// dedicated page's path when that page failed to compile (e.g. a syntax error),
// which makes its route disappear and silently falls through to here.
// When that happens, re-import the offending page module to re-trigger Vite
// compilation so the REAL compiler error (with file name and line number) is
// surfaced to the developer, instead of masking it by rendering unrelated CMS
// content or a useless stack trace pointing to this catch-all file.
const RESERVED_PAGE_MODULES: Record<string, () => Promise<unknown>> = {
  '/': () => import('./index.astro'),
  '/news': () => import('./news.astro'),
  '/news-client': () => import('./news-client.astro'),
  '/search': () => import('./search.astro'),
};
const normalizedPath = pathFromUrl !== '/' && pathFromUrl.endsWith('/')
  ? pathFromUrl.slice(0, -1)
  : pathFromUrl;
if (!pathFromQuery && normalizedPath in RESERVED_PAGE_MODULES) {
  // Re-import the dedicated page. If it has a compile/syntax error this throws
  // the actual Vite/Astro compiler error pointing at the exact line in that page.
  await RESERVED_PAGE_MODULES[normalizedPath]();
  // Import unexpectedly succeeded: the page compiles but still fell through here.
  throw new Error(
    `Route "${normalizedPath}" is owned by a dedicated page ` +
    `(src/pages${normalizedPath === '/' ? '/index' : normalizedPath}.astro) but the request ` +
    `fell through to the catch-all [...slug].astro. Fix the routing or the page source.`
  );
}

// Reject static assets (files with extensions) and non-page paths
// Only allow paths ending with / or .html
if (pathFromUrl !== '/' && !pathFromUrl.endsWith('/') && !pathFromUrl.endsWith('.html')) {
  return new Response('Not found', { status: 404 });
}

let page = null;
let error = '';

try {
  const result = await getPage(apiPath, undefined, Astro.request);
  page = result.data;

  // Forward Set-Cookie headers to the browser
  const setCookie = result.headers.get('set-cookie');
  if (setCookie) {
    Astro.response.headers.append('Set-Cookie', setCookie);
  }
} catch (e: unknown) {
  const err = e instanceof Error ? e : new Error(String(e));
  console.error(`[slug].astro] Error loading page at ${apiPath}:`, err);
  // @ts-ignore - import.meta.env is valid in Astro SSR context
  if (import.meta.env.DEV) {
    throw err;
  }
  error = err.message;
}

const navResult = await getNavigation(Astro.request, apiPath, undefined, 2);
const nav = navResult.data;

// Forward Set-Cookie headers to the browser
const navSetCookie = navResult.headers.get('set-cookie');
if (navSetCookie) {
  Astro.response.headers.append('Set-Cookie', navSetCookie);
}
---

<Layout title={page?.title || 'WebJET CMS — Headless Demo'} navItems={nav} currentPath={apiPath}>
  {error ? (
    <div class="error"><strong>Error:</strong> {error}</div>
  ) : page ? (
    <article class="content">
      <h1>{page.title}</h1>
      <p class="content-meta">
        <span>{page.virtualPath}</span>
        {page.language && <span> &middot; {page.language}</span>}
      </p>
      <div class="content-body" set:html={page.body}></div>
    </article>
  ) : (
    <div class="empty-state">
      <p>Enter a path to load a page.</p>
    </div>
  )}
</Layout>
