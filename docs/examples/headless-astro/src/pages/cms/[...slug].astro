---
import { getPage, getNavigation } from '../../lib/api';
import Layout from '../../layouts/Layout.astro';

// CMS content renderer.
//
// This catch-all lives under /cms/ on purpose: it must NOT share a URL with any
// dedicated top-level page (/, /news, /search, ...). If it did, Astro's dev
// router would silently fall through to it whenever a dedicated page fails to
// compile (see src/middleware.ts for the full explanation), masking the real
// error. Living under /cms/ guarantees a broken dedicated page has no fallback
// route, so Astro surfaces the actual compiler error in the browser.
//
// The original request path is forwarded by the middleware via the `path` query
// parameter.
const apiPath = Astro.url.searchParams.get('path') || '/';

let page = null;
let error = '';

try {
  const result = await getPage(apiPath, undefined, Astro.request);
  page = result.data;

  // Forward Set-Cookie headers to the browser
  const setCookie = result.headers.get('set-cookie');
  if (setCookie) {
    Astro.response.headers.append('Set-Cookie', setCookie);
  }
} catch (e: unknown) {
  const err = e instanceof Error ? e : new Error(String(e));
  console.error(`[cms/[...slug].astro] Error loading page at ${apiPath}:`, err);
  // @ts-ignore - import.meta.env is valid in Astro SSR context
  if (import.meta.env.DEV) {
    throw err;
  }
  error = err.message;
  Astro.response.status = 404;
}

const navResult = await getNavigation(Astro.request, apiPath, undefined, 2);
const nav = navResult.data;

// Forward Set-Cookie headers to the browser
const navSetCookie = navResult.headers.get('set-cookie');
if (navSetCookie) {
  Astro.response.headers.append('Set-Cookie', navSetCookie);
}
---

<Layout title={page?.title || 'WebJET CMS — Headless Demo'} navItems={nav} currentPath={apiPath}>
  {error ? (
    <div class="error"><strong>Error:</strong> {error}</div>
  ) : page ? (
    <article class="content">
      <h1>{page.title}</h1>
      <p class="content-meta">
        <span>{page.virtualPath}</span>
        {page.language && <span> &middot; {page.language}</span>}
      </p>
      <div class="content-body" set:html={page.body}></div>
    </article>
  ) : (
    <div class="empty-state">
      <p>Enter a path to load a page.</p>
    </div>
  )}
</Layout>
