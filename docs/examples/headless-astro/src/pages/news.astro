---
import { listNews, getNavigation } from '../lib/api';
import Layout from '../layouts/Layout.astro';

// Server-side rendering: fetches news directly from CMS at render time
const NEWS_GROUP_ID = 24;
const NEWS_PAGE_SIZE = 5;
const requestedPage = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const newsPage = Number.isFinite(requestedPage) && requestedPage > 0 ? requestedPage : 1;

let newsResult: any = { items: [], page: 1, size: NEWS_PAGE_SIZE, totalElements: 0, totalPages: 0 };
let newsError = '';

try {
  const result = await listNews(
    {
      groupIds: [NEWS_GROUP_ID],
      alsoSubGroups: true,
      publishType: 'new',
      order: 'date',
      ascending: false,
      paging: true,
      pageSize: NEWS_PAGE_SIZE,
      offset: (newsPage - 1) * NEWS_PAGE_SIZE,
      perexNotRequired: false,
      loadData: false,
      checkDuplicity: false,
      perexGroup: [],
      perexGroupNot: [],
    },
    Astro.request
  );
  newsResult = result.data;

  // Forward Set-Cookie headers to the browser
  const setCookie = result.headers.get('set-cookie');
  if (setCookie) {
    Astro.response.headers.append('Set-Cookie', setCookie);
  }
} catch (e: unknown) {
  const err = e instanceof Error ? e : new Error(String(e));
  console.error('[news.astro] Error loading news:', err);
  // @ts-ignore - import.meta.env is valid in Astro SSR context
  if (import.meta.env.DEV) {
    throw err;
  }
  newsError = err.message;
}

const navResult = await getNavigation(Astro.request, '/', undefined, 2);
const nav = navResult.data;

// Forward Set-Cookie headers to the browser
const navSetCookie = navResult.headers.get('set-cookie');
if (navSetCookie) {
  Astro.response.headers.append('Set-Cookie', navSetCookie);
}

// Helper: build tag data from perexGroup (rendered in the template below)
function buildTags(perexGroup: number[] | undefined) {
  if (!perexGroup || !Array.isArray(perexGroup)) return [];
  const tags: { class: string; text: string }[] = [];
  for (const pg of perexGroup) {
    if (pg === 1) tags.push({ class: 'tag c1', text: 'Investície' });
    if (pg === 2) tags.push({ class: 'tag c2', text: 'Podnikanie' });
  }
  return tags;
}
---

<Layout
  title={`News — WebJET CMS`}
  navItems={nav}
  currentPath="/news"
>
  <section class="md-news-subpage">
    <div class="container">
      {newsError ? (
        <div class="error"><strong>Error:</strong> {newsError}</div>
      ) : newsResult.items && newsResult.items.length > 0 ? (
        <>
        {newsResult.items.map((item: any) => {
          // Thumbnail URL from perexImageNormal (DocDetails property)
          const thumbSrc = item.perexImage
            ? `/thumb${item.perexImage}?w=400&h=300&ip=6`
            : '';

          // perexPre text (DocDetails property)
          const perexText = item.htmlData || '';

          return (
            <div class="row justify-content-md-center">
              <div class="col-sm-2">
                {thumbSrc && (
                  <a href={item.virtualPath}>
                    <img src={thumbSrc} class="img-responsive" alt={item.title} />
                  </a>
                )}
                {buildTags(item.perexGroups).map((t) => (
                  <span class={t.class}>{t.text}</span>
                ))}
              </div>
              <div class="col-sm-6">
                <h3><a href={item.virtualPath}>{item.title}</a></h3>
                <p>{perexText}</p>
              </div>
            </div>
          );
        })}
        {newsResult.totalPages > 1 && (
        <div class="pagination">
          {newsResult.page > 1 ? (
            <a href={`/news?page=${newsResult.page - 1}`}>&laquo; Prev</a>
          ) : (
            <span class="disabled">&laquo; Prev</span>
          )}
          <span class="current">Page {newsResult.page} of {newsResult.totalPages}</span>
          {newsResult.page < newsResult.totalPages ? (
            <a href={`/news?page=${newsResult.page + 1}`}>Next &raquo;</a>
          ) : (
            <span class="disabled">Next &raquo;</span>
          )}
        </div>
        )}
        </>
      ) : (
        <div class="no-results">
          <p>No news items found for the configured group.</p>
        </div>
      )}
    </div>
  </section>
</Layout>
