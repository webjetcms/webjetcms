include ../pug/mixins

div#branch-band.md-branch-bar(data-th-if="${branchScreen.allowed and branchScreen.branchId > 0}" data-th-data-branch-color="${branchScreen.color}")
    button#branch-switcher.md-branch-bar__switch(type="button" disabled aria-haspopup="dialog" aria-controls="branch-picker" aria-expanded="false" data-th-aria-label="\#{branches.switch.js}")
        i.ti.ti-git-branch.md-branch-bar__icon(aria-hidden="true")
        span.md-branch-bar__text
            small(data-th-text="\#{branches.label}") Pracovná verzia
            strong#branch-active-label(data-th-text="${branchScreen.name}")
        i.ti.ti-chevron-down(aria-hidden="true")
    span#branch-state.md-branch-bar__state(hidden)
    div.md-branch-bar__actions
        button#branch-changes.btn.btn-sm.btn-outline-secondary.d-none(type="button")
            i.ti.ti-list-check(aria-hidden="true")
            span(data-th-text="\#{branches.changes.js}") Pracovné zmeny
        a#branch-preview-link.btn.btn-sm.btn-outline-secondary.d-none(target="_blank" rel="noopener")
            i.ti.ti-external-link(aria-hidden="true")
            span(data-th-text="\#{branches.preview}") Náhľad

div.ly-container.container

    div.header-link-group.header-branding

        button.btn.btn-sm.btn-outline-secondary.js-sidebar-toggler(type="button" data-th-aria-label="\#{templates.temps-list.main-navigation}" aria-label="Toggle navigation")
            i.ti.ti-menu-2(aria-hidden="true")

        include ./environment

        button#branch-switcher.md-branch-switch(data-th-if="${branchScreen.allowed and branchScreen.branchId == 0}" type="button" disabled aria-haspopup="dialog" aria-controls="branch-picker" aria-expanded="false" data-th-with="switchLabel=\#{branches.main.js} + ' · ' + \#{branches.switch.js}" data-th-title="${switchLabel}" data-th-aria-label="${switchLabel}")
            i.ti.ti-git-branch(aria-hidden="true")
        .header-title(role="heading" aria-level="1")

    div.header-link-wrapper

        div.header-link-group

            button.btn.btn-sm.md-quick-search-trigger.js-search-toggler(type="button" data-th-aria-label="\#{admin.quickSearch.title.js}" aria-haspopup="dialog" aria-controls="admin-quick-search")
                i.ti.ti-search(aria-hidden="true")
                span.md-quick-search-trigger__label(data-th-text="\#{admin.quickSearch.trigger.js}") Hľadať…
                kbd.md-quick-search-trigger__shortcut(aria-hidden="true") Ctrl K

        div.header-link-group

            include ./help-menu

        div.header-link-group

            include ./user-menu

        div.header-link-group(style="margin-left: 4px;")

            a.btn.btn-sm.btn-outline-secondary.js-logout-toggler(href="javascript:document.adminLogoffForm.submit()" data-th-title="\#{menu.logout}" data-th-aria-label="\#{menu.logout}" data-bs-toggle="tooltip")
                i.ti.ti-logout.notext(aria-hidden="true")

    form(data-th-action="${layout.getConstant('adminLogoffLink')}" method="post" name="adminLogoffForm" style="display:none;")
        input(type="hidden" data-th-name="${layout.csrfParameterName}" data-th-value="${layout.csrfToken}")

    div.ly-submenu
