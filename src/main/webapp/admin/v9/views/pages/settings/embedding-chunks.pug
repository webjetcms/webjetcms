extends ../../partials/layout

block content

    script
        include embedding-logic.js

    script.
        var embeddingChunksDataTable;

        var url = "/admin/rest/settings/embedding-chunks";
        var columns = [(${layout.getDataTableColumns('sk.iway.iwcm.rag.pgvector.EmbeddingChunkEntity')})];

        WJ.headerTabs({
            id: 'embedding-chunks',
            tabs: getHeaderTabs()
        });

        WJ.breadcrumb({
            id: 'embedding-chunks',
            noBorderBottom: true,
            tabs: [
                { url: '#bonusFilter', title: '{filter}', active: false }
            ]
        });

        document.querySelectorAll('#pills-embedding-chunks .nav-link').forEach(tab => {
            tab.addEventListener('click', function () {
                // Wait a tick so the "active" class updates
                setTimeout(() => {
                    initPage();
                }, 0);
            });
        });

        window.domReady.add(function () {
            embeddingChunksDataTable = WJ.DataTable({
                url: url,
                columns: columns,
                serverSide: true,
                fetchOnCreate: true,
                fetchOnEdit: true
            });
            embeddingChunksDataTable.hideButtons(["create", "remove", "celledit", "import", "duplicate"]);

            var buttonCounter = 2;
            embeddingChunksDataTable.button().add(buttonCounter++, getAddIndexButton());
            embeddingChunksDataTable.button().add(buttonCounter++, getRemoveIndexButton());

            initPage();
            loadCurrentEmbeddingConfiguration();
        });

        function loadCurrentEmbeddingConfiguration() {
            fetch(url + "/current-embedding-configuration", {
                method: "GET",
                headers: { "X-CSRF-Token": window.csrfToken }
            })
            .then(response => {
                if(response.ok === false) throw new Error("Failed to load current embedding configuration");
                return response.json();
            })
            .then(data => {
                if(data.provider == null || data.provider.length === 0 || data.model == null || data.model.length === 0) {
                    throw new Error("Current embedding configuration is not available");
                }

                const message = "[[\#{settings.embedding-chunks.embeddingProvider}]]: <strong>" + WJ.escapeHtml(data.provider) + "</strong><br>" +
                    "[[\#{settings.embedding-chunks.embeddingModel}]]: <strong>" + WJ.escapeHtml(data.model) + "</strong>";
                WJ.notifyInfo("[[\#{settings.embedding-chunks.currentConfiguration}]]", message, 5000);
            })
            .catch(() => {
                WJ.notifyWarning(
                    "[[\#{settings.embedding-chunks.currentConfiguration}]]",
                    "[[\#{settings.embedding-chunks.currentConfigurationUnavailable}]]",
                    5000
                );
            });
        }

    style.
        label[for=includeSubfolders]::after {
            content: "\ec9f" !important;
            font-size: 18px !important;
        }

        #embeddingChunksDataTable_extfilter .custom-modal .custom-modal-wrapper {
            margin: 32px auto;
        }

        #embeddingChunksDataTable_extfilter .custom-modal .jstree {
            height: min(600px, calc(100vh - 240px));
            max-height: calc(100vh - 240px);
            overflow-y: auto;
        }

        table.datatableInit tbody tr.is-pending td,
        table.datatableInit tbody tr.is-pending td a {
            color: #FABD00;
        }

        table.datatableInit tbody tr.is-error td,
        table.datatableInit tbody tr.is-error td a {
            color: #FF4B58;
        }

    table.datatableInit.table
