extends ../../partials/layout

block content

    script.
        window.domReady.add(function () {

            WJ.selectMenuItem("/admin/v9/settings/update/");

            const endpoint = "/admin/rest/settings/stat-browser-migration";
            let state = {};
            let pollTimeout;
            let lastError;
            let statusLoadFailed = false;
            let pendingFinalization = 0;

            function renderState() {
                if (state.finalized) pendingFinalization = 0;
                $("#migrationScanned").text(state.scanned || 0);
                $("#migrationUpdated").text(state.updated || 0);
                $("#migrationTable").text(state.table || "—");
                const percent = state.done ? 100 : (state.tableMaxId > 0 ? Math.min(100, Math.round(state.cursor * 100 / state.tableMaxId)) : 0);
                const checkingReferences = state.running && state.finalizing && state.tableMaxId === 0;
                const mergingErrors = state.running && state.mergingStatErrors;
                const indeterminate = checkingReferences || mergingErrors;
                let progressText = percent + "%";
                if (checkingReferences) progressText = "[[\#{stat.browser-migration.checking-references}]]";
                if (mergingErrors) progressText = "[[\#{stat.browser-migration.merging-errors}]]";
                $("#migrationProgress").css("width", indeterminate ? "100%" : percent + "%")
                    .toggleClass("progress-bar-striped progress-bar-animated", indeterminate)
                    .attr("aria-valuenow", indeterminate ? null : percent)
                    .text(progressText);
                const totalTables = state.totalTables || 0;
                const completedTables = state.done ? totalTables : Math.min(state.tableIndex || 0, totalTables);
                const overallPercent = state.done ? 100 : (totalTables > 0 ? Math.round(completedTables * 100 / totalTables) : 0);
                $("#migrationCompletedTables").text(completedTables);
                $("#migrationTotalTables").text(totalTables);
                $("#migrationOverallProgress").css("width", overallPercent + "%").attr("aria-valuenow", overallPercent).text(overallPercent + "%");
                $("#migrationStart").prop("disabled", state.running || state.done);
                $("#migrationPause").prop("disabled", !state.running || state.stopRequested || state.finalizing);
                $("#migrationFinalize").prop("disabled", state.running || !state.done || pendingFinalization < 1);
                $("#migrationStatus").toggleClass("d-none", !state.done);
                $("#migrationStopping").toggleClass("d-none", !state.stopRequested);
                $("#migrationPaused").toggleClass("d-none", !state.paused);
                $("#migrationFinalizing").toggleClass("d-none", !state.finalizing);
                $("#migrationFinalized").toggleClass("d-none", !state.finalized);
                $("#migrationDeletedKeys").text(state.deletedStatKeys || 0);
                $("#migrationRetainedKeys").text(state.retainedStatKeys || 0);

                if (state.error && state.error !== lastError) {
                    lastError = state.error;
                    WJ.notifyError("[[\#{stat.browser-migration.error}]] " + state.error);
                }
                if (!state.error) lastError = null;
            }

            function renderPreview(data) {
                $("#seoMappingCount").text(data.seoBots.length);
                $("#keyMappingCount").text(data.browserKeys.length);
                pendingFinalization = data.seoBots.length + data.browserKeys.length + (data.seoBotsIndexReady === false ? 1 : 0);
                $("#tableCount").text(data.tables.length);
                if (!state.totalTables) {
                    state.totalTables = data.tables.length;
                    renderState();
                }
                const body = $("#migrationMappings tbody").empty();
                data.seoBots.concat(data.browserKeys).forEach(item => {
                    $("<tr>").append($("<td>").text(item.source)).append($("<td>").text(item.target)).appendTo(body);
                });
                $("#migrationPreview").removeClass("d-none");
                renderState();
            }

            function analyze() {
                $("#migrationAnalyze").prop("disabled", true).addClass("processing");
                $.getJSON(endpoint).done(renderPreview).fail(() => WJ.notifyError("[[\#{stat.browser-migration.error}]]"))
                    .always(() => $("#migrationAnalyze").prop("disabled", false).removeClass("processing"));
            }

            function scheduleStatusPoll() {
                window.clearTimeout(pollTimeout);
                if (state.running || state.stopRequested) pollTimeout = window.setTimeout(loadStatus, 1000);
            }

            function updateState(response) {
                statusLoadFailed = false;
                state = response;
                renderState();
                scheduleStatusPoll();
            }

            function loadStatus() {
                $.getJSON(endpoint + "/status")
                    .done(updateState)
                    .fail(() => {
                        if (!statusLoadFailed) WJ.notifyError("[[\#{stat.browser-migration.error}]]");
                        statusLoadFailed = true;
                        pollTimeout = window.setTimeout(loadStatus, 3000);
                    });
            }

            $("#migrationAnalyze").on("click", analyze);
            $("#migrationStart").on("click", function () {
                $(this).prop("disabled", true).addClass("processing");
                $.post(endpoint + "/start").done(updateState)
                    .fail(() => {
                        $("#migrationStart").prop("disabled", false);
                        WJ.notifyError("[[\#{stat.browser-migration.error}]]");
                    })
                    .always(() => $(this).removeClass("processing"));
            });
            $("#migrationPause").on("click", function () {
                $(this).prop("disabled", true);
                $.post(endpoint + "/stop").done(updateState)
                    .fail(() => {
                        $("#migrationPause").prop("disabled", !state.running);
                        WJ.notifyError("[[\#{stat.browser-migration.error}]]");
                    });
            });
            $("#migrationFinalize").on("click", function () {
                WJ.confirm({
                    title: "[[\#{stat.browser-migration.finalize-confirm-title}]]",
                    message: "[[\#{stat.browser-migration.finalize-confirm-message}]]",
                    success: function () {
                        $("#migrationFinalize").prop("disabled", true).addClass("processing");
                        $.post(endpoint + "/finalize").done(updateState)
                            .fail(() => WJ.notifyError("[[\#{stat.browser-migration.error}]]"))
                            .always(() => $("#migrationFinalize").removeClass("processing"));
                    }
                });
            });
            loadStatus();
        });

    div.dt-header-row.clearfix
        div.dt-buttons
            button#migrationAnalyze.btn.btn-sm.btn-outline-secondary.with-text(type="button")
                i.ti.ti-scan
                span [[\#{stat.browser-migration.analyze}]]
            button#migrationStart.btn.btn-sm.btn-success.with-text(type="button")
                i.ti.ti-player-play
                span [[\#{stat.browser-migration.start}]]
            button#migrationPause.btn.btn-sm.btn-warning.with-text(type="button" disabled)
                i.ti.ti-player-pause
                span [[\#{stat.browser-migration.pause}]]
            button#migrationFinalize.btn.btn-sm.btn-outline-danger.with-text(type="button" disabled)
                i.ti.ti-database-check
                span [[\#{stat.browser-migration.finalize}]]

    .alert.alert-info.mt-3(role="alert")
        i.ti.ti-info-circle.me-2
        | [[\#{stat.browser-migration.description}]]

    #migrationStatus.alert.alert-success.d-none(role="status") [[\#{stat.browser-migration.done}]]
    #migrationStopping.alert.alert-info.d-none(role="status") [[\#{stat.browser-migration.stopping}]]
    #migrationPaused.alert.alert-warning.d-none(role="status") [[\#{stat.browser-migration.paused}]]
    #migrationFinalizing.alert.alert-info.d-none(role="status") [[\#{stat.browser-migration.finalizing}]]
    #migrationFinalized.alert.alert-success.d-none(role="status")
        | [[\#{stat.browser-migration.finalize-success-prefix}]]
        strong#migrationDeletedKeys.mx-1 0
        | [[\#{stat.browser-migration.finalize-success-deleted}]]
        strong#migrationRetainedKeys.mx-1 0
        | [[\#{stat.browser-migration.finalize-success-retained}]]

    .card.mb-3
        .card-body
            .row.g-3
                .col-md-4
                    .text-muted [[\#{stat.browser-migration.current-table}]]
                    #migrationTable.fs-5 —
                .col-md-4
                    .text-muted [[\#{stat.browser-migration.scanned}]]
                    #migrationScanned.fs-5 0
                .col-md-4
                    .text-muted [[\#{stat.browser-migration.updated}]]
                    #migrationUpdated.fs-5 0
            .d-flex.justify-content-between.mt-3
                .text-muted [[\#{stat.browser-migration.current-progress}]]
            .progress.mt-1
                #migrationProgress.progress-bar(role="progressbar" style="width: 0%" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0") 0%
            .d-flex.justify-content-between.mt-3
                .text-muted [[\#{stat.browser-migration.overall-progress}]]
                .text-muted
                    span#migrationCompletedTables 0
                    |  /
                    span#migrationTotalTables 0
                    |  [[\#{stat.browser-migration.table-count}]]
            .progress.mt-1
                #migrationOverallProgress.progress-bar.bg-success(role="progressbar" style="width: 0%" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0") 0%

    #migrationPreview.card.d-none
        .card-header [[\#{stat.browser-migration.preview}]]
        .card-body
            p
                span.badge.bg-primary.me-2#seoMappingCount 0
                | [[\#{stat.browser-migration.seo-count}]]
                span.badge.bg-secondary.ms-3.me-2#keyMappingCount 0
                | [[\#{stat.browser-migration.key-count}]]
                span.badge.bg-info.ms-3.me-2#tableCount 0
                | [[\#{stat.browser-migration.table-count}]]
            .table-responsive(style="max-height: 420px")
                table#migrationMappings.table.table-sm.table-hover
                    thead
                        tr
                            th [[\#{stat.browser-migration.source}]]
                            th [[\#{stat.browser-migration.target}]]
                    tbody
