extends ../../partials/layout

block content
    - const includeSkills = false
    include ../../partials/ai-instructions-field

    script.
        window.helpLink = "/redactor/ai/settings/README";
        var aiSkillsDataTable;

        window.domReady.add(function () {
            const columns = [(${layout.getDataTableColumns('sk.iway.iwcm.components.ai.jpa.AiSkillEntity')})];
            aiSkillsDataTable = WJ.DataTable({
                id: "aiSkillsDataTable",
                url: "/admin/rest/settings/ai-skills",
                columns,
                tabs: [(${layout.getDataTableTabs('sk.iway.iwcm.components.ai.jpa.AiSkillEntity')})],
                order: [ [columns.findIndex(column => column.data === "name"), "asc"] ],
                serverSide: true,
                fetchOnEdit: true
            });
            aiSkillsDataTable.EDITOR.on("open", initAiInstructionsField);
        });

    table#aiSkillsDataTable.datatableInit.table(th:attr="aria-label=#{components.ai_assistants.skills.title}")
