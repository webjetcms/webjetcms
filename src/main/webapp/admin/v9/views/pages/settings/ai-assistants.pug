extends ../../partials/layout

block content

    template#assistant-tools-template
        fieldset
            .d-flex.gap-2.mb-3
                select.form-select(data-live-search="true" th:attr="aria-label=#{components.ai_assistants.tools.name}")
                button.btn.btn-primary(type="button" th:text="#{button.add}")
            .table-responsive
                table.table.align-middle(th:attr="aria-label=#{components.ai_assistants.tools.title}")
                    thead
                        tr
                            th(scope="col" th:text="#{components.ai_assistants.tools.name}")
                            th(scope="col" th:text="#{components.ai_assistants.tools.description}")
                            th(scope="col")
                                span.visually-hidden(th:text="#{editor.form.action}")
                    tbody
                    tfoot
                        tr
                            td.text-center(colspan="3" th:text="#{components.ai_assistants.tools.none_assigned}")
            template
                button.btn.btn-sm.btn-outline-danger(type="button" th:title="#{components.ai_assistants.tools.remove}")
                    i.ti.ti-trash(aria-hidden="true")

    script
        include assistant-tool-field.js

    script.
        window.helpLink = "/redactor/ai/settings/README";
        var aiAssistantsDataTable;

        var fieldsWereSet = false;
        var hideOnCreate = [];
        var hideOnEdit = [];

        let url = "/admin/rest/ai/assistant-definition/";

        window.domReady.add(function () {

            var tabs = [(${layout.getDataTableTabs('sk.iway.iwcm.components.ai.jpa.AssistantDefinitionEntity')})];

            var columns = [(${layout.getDataTableColumns('sk.iway.iwcm.components.ai.jpa.AssistantDefinitionEntity')})];

            for(let i = 0; i < columns.length; i++) {
                var columnClassName = columns[i]?.className;
                if(columnClassName == undefined || columnClassName == null) {
                    columnClassName = "";
                }

                if(columnClassName.indexOf("hideOnCreate") != -1) {
                    hideOnCreate.push(columns[i].data);
                    columnClassName = columnClassName.replace("hideOnCreate", "");
                }

                if(columnClassName.indexOf("hideOnEdit") != -1) {
                    hideOnEdit.push(columns[i].data);
                    columnClassName = columnClassName.replace("hideOnEdit", "");
                }

                columns[i].className = columnClassName;
            }

            let order = [];
            order.push([1, 'asc']);

            aiAssistantsDataTable = WJ.DataTable({
                url: "/admin/rest/ai/assistant-definition/",
                columns: columns,
                serverSide: true,
                tabs: tabs,
                order: order,
                fetchOnCreate: true,
                fetchOnEdit: true
            });

            const editor = aiAssistantsDataTable.EDITOR;
            const editorFields = editor.fields();
            if (editorFields.includes("toolNames")) {
                const toolField = $(editor.field("toolNames").node());
                toolField.children("label").addClass("visually-hidden");
                toolField.children('[data-dte-e="input"]').addClass("w-100");
            }

            var eventsBinded = false;
            aiAssistantsDataTable.EDITOR.on( 'open', function ( e, data, action ) {
                if (eventsBinded==false) {
                    $("#DTE_Field_provider").on("change", function() {
                        changeFieldsVisibility($(this).val(), action);

                        let oldValue = aiAssistantsDataTable.EDITOR.currentJson["provider"];
                        let newValue = $("#DTE_Field_provider").val();
                        if((oldValue == null && newValue != null) || (oldValue != null && newValue == null) || (oldValue != newValue)) {
                            //Provider was changed and oldValue != newValue ... so remove value from model
                            $("#DTE_Field_model").val("").trigger("change");
                        }
                    });

                    $("#DTE_Field_description, #DTE_Field_model").on("blur change", function() {
                        getTranslatedKey($("#DTE_Field_description").val(), "editorFields-translatedDescription");
                    });

                    $("#DTE_Field_userPromptLabel").on("blur", function() {
                        getTranslatedKey($("#DTE_Field_userPromptLabel").val(), "editorFields-translatedUserPromptLabel");
                    });

                    eventsBinded = true;
                }
                initInstructionsEnhancements();
            });

            function initInstructionsEnhancements() {
                var textarea = document.getElementById("DTE_Field_instructions");
                var lines = WJ.initTextareaLineNumbers(textarea, {toggleWrapOnDoubleClick: true});
                if (!textarea || $(textarea).data("instructions-enhanced")) return;

                $(textarea).on("keydown", function(event) {
                    if (event.key !== "Tab") return;
                    event.preventDefault();
                    var start = this.selectionStart;
                    var end = this.selectionEnd;
                    this.value = this.value.substring(0, start) + "\t" + this.value.substring(end);
                    this.selectionStart = this.selectionEnd = start + 1;
                    lines.refresh();
                });
                $(textarea).data("instructions-enhanced", true);
            }

            function changeFieldsVisibility(provider, action) {
                $.ajax({
                    type: "GET",
                    url: url + "provider-fields",
                    data: {
                        "provider": provider,
                        "action": action
                    },
                    success: function(res)
                    {
                        var toShow = Object.values(res);

                        if("create" == action) {
                            hideOnCreate.forEach(function(fieldName) {
                                if (!editorFields.includes(fieldName)) return;
                                if(toShow.includes(fieldName)) {
                                    aiAssistantsDataTable.EDITOR.field(fieldName).show();
                                } else {
                                    aiAssistantsDataTable.EDITOR.field(fieldName).hide();
                                }
                            });
                        } else if("edit" == action) {
                            hideOnEdit.forEach(function(fieldName) {
                                if (!editorFields.includes(fieldName)) return;
                                if(toShow.includes(fieldName)) {
                                    aiAssistantsDataTable.EDITOR.field(fieldName).show();
                                } else {
                                    aiAssistantsDataTable.EDITOR.field(fieldName).hide();
                                }
                            });
                        }
                    },
                    error: function(xhr, ajaxOptions, thrownError) {

                    }
                });
            }

            function getTranslatedKey(keyToTranslate, fieldId) {
                if(keyToTranslate == undefined || keyToTranslate == null || keyToTranslate == "") return;

                let data = { key: keyToTranslate };
                if (fieldId === "editorFields-translatedDescription") data.model = $("#DTE_Field_model").val() || "";

                $.ajax({
                    url: url + "translate-key",
                    method: "get",
                    contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                    data: data,
                    success: function(response) {
                        $("#DTE_Field_" + fieldId).val(response);
                    }
                });
            }
        });

    style.
        #datatableInit_modal .DTE_Field_Type_assistantTools {
            margin-inline: 0;
        }
        #datatableInit_modal .DTE_Field_Type_assistantTools :is(th, td) {
            white-space: normal;
            overflow-wrap: anywhere;
        }
        #datatableInit_modal .DTE_Field_Type_assistantTools th:first-child { width: 30%; }
        #datatableInit_modal .DTE_Field_Type_assistantTools th:last-child { width: 3rem; }

        div.DTE_Field_Name_instructions label { display: none; }
        div.DTE_Field_Name_instructions .md-textarea-editor { height: 502px; }

        label[for='DTE_Field_editorFields-translatedDescription'] { visibility: hidden; }
        div.DTE_Field_Name_editorFields\.translatedDescription div.form-group-tooltip { display: none; }

        label[for='DTE_Field_editorFields-translatedUserPromptLabel'] { visibility: hidden; }
        div.DTE_Field_Name_editorFields\.translatedUserPromptLabel div.form-group-tooltip { display: none; }

        tr.not-active td {
            color: var(--bs-danger) !important;
        }

        tr.not-active td div a {
            color: var(--bs-danger) !important;
        }

        tr.not-init td {
            color: var(--bs-warning) !important;
        }

        tr.not-init td div a {
            color: var(--bs-warning) !important;
        }

    table.datatableInit.table
