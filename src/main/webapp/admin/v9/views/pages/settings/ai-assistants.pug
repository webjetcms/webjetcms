extends ../../partials/layout

block content

    script.
        window.helpLink = "/redactor/ai/settings/README";
        var aiAssistantsDataTable;

        var fieldsWereSet = false;
        var hideOnCreate = [];
        var hideOnEdit = [];

        let url = "/admin/rest/ai/assistant-definition/";

        window.domReady.add(function () {

            let tokenUsageChart;

            var tabs = [
                {id: 'basic', title: '[[\#{datatable.tab.basic}]]', selected: true},
                {id: 'action', title: '[[\#{editor.form.action}]]'},
                {id: 'provider', title: '[[\#{components.ai_assistants.provider}]]'},
                {id: 'instructions', title: '[[\#{components.ai_assistants.instruction_tab}]]'},
                {id: 'advanced', title: '[[\#{datatable.tab.advanced}]]'},
                {id: 'tokenLimits', title: '[[\#{components.ai_assistants.token_limits}]]'}
            ]

            var columns = [(${layout.getDataTableColumns('sk.iway.iwcm.components.ai.jpa.AssistantDefinitionEntity')})];

            for(let i = 0; i < columns.length; i++) {
                var columnClassName = columns[i]?.className;
                if(columnClassName == undefined || columnClassName == null) {
                    columnClassName = "";
                }

                if(columnClassName.indexOf("hideOnCreate") != -1) {
                    hideOnCreate.push(columns[i].data);
                    columnClassName = columnClassName.replace("hideOnCreate", "");
                }

                if(columnClassName.indexOf("hideOnEdit") != -1) {
                    hideOnEdit.push(columns[i].data);
                    columnClassName = columnClassName.replace("hideOnEdit", "");
                }

                columns[i].className = columnClassName;
            }

            let order = [];
            order.push([columns.findIndex(column => column.data === "name"), 'asc']);

            aiAssistantsDataTable = WJ.DataTable({
                url: "/admin/rest/ai/assistant-definition/",
                columns: columns,
                serverSide: true,
                tabs: tabs,
                order: order,
                fetchOnCreate: true,
                fetchOnEdit: true,
                onXhr: function(TABLE, e, settings, json) {
                    if (!json?.summary || !("nextTokenReset" in json.summary)) return;
                    let nextReset = json.summary.nextTokenReset;
                    let info = $("#tokenResetInfo");
                    info.toggleClass("d-none", !nextReset);
                    info.find("span").text(nextReset ? '[[\#{components.ai_assistants.token_reset.next}]]'.replace("{1}", WJ.formatDateTimeSeconds(nextReset)) : "");
                    document.body.style.setProperty("--dt-autoheight-offset", nextReset ? Math.ceil(info.outerHeight(true)) : 0);
                }
            });

            aiAssistantsDataTable.button().add(null, {
                text: '<i class="ti ti-eraser" aria-hidden="true"></i>',
                className: 'btn btn-warning buttons-reset-token-usage buttons-divider-left',
                init: function(dt) {
                    $.fn.dataTable.Buttons.showIfRowSelected(this, dt);
                },
                action: function() {
                    aiAssistantsDataTable.executeAction("resetTokenUsage", false, "[[\#{components.ai_assistants.token_reset.title}]]", "[[\#{components.ai_assistants.token_reset.selected.confirm}]]");
                },
                attr: {
                    title: '[[\#{components.ai_assistants.token_reset.selected}]]',
                    'aria-label': '[[\#{components.ai_assistants.token_reset.selected}]]',
                    'data-toggle': 'tooltip'
                }
            });

            aiAssistantsDataTable.button().add(null, {
                text: '<i class="ti ti-eraser" aria-hidden="true"></i>',
                className: 'btn btn-warning buttons-reset-all-token-usage',
                init: function(dt) {
                    $.fn.dataTable.Buttons.showIfRowUnselected(this, dt);
                },
                action: function() {
                    if (aiAssistantsDataTable.rows({selected: true}).any()) return;
                    aiAssistantsDataTable.executeAction("resetAllTokenUsage", true, "[[\#{components.ai_assistants.token_reset.title}]]", "[[\#{components.ai_assistants.token_reset.all.confirm}]]");
                },
                attr: {
                    title: '[[\#{components.ai_assistants.token_reset.all}]]',
                    'aria-label': '[[\#{components.ai_assistants.token_reset.all}]]',
                    'data-toggle': 'tooltip'
                }
            });

            var eventsBinded = false;
            aiAssistantsDataTable.EDITOR.on( 'open', function ( e, data, action ) {
                if (eventsBinded==false) {
                    $("#DTE_Field_provider").on("change", function() {
                        changeFieldsVisibility($(this).val(), action);

                        let oldValue = aiAssistantsDataTable.EDITOR.currentJson["provider"];
                        let newValue = $("#DTE_Field_provider").val();
                        if((oldValue == null && newValue != null) || (oldValue != null && newValue == null) || (oldValue != newValue)) {
                            //Provider was changed and oldValue != newValue ... so remove value from model
                            $("#DTE_Field_model").val("");
                        }
                    });

                    $("#DTE_Field_description").on("blur", function() {
                        getTranslatedKey($("#DTE_Field_description").val(), "editorFields-translatedDescription");
                    });

                    $("#DTE_Field_userPromptLabel").on("blur", function() {
                        getTranslatedKey($("#DTE_Field_userPromptLabel").val(), "editorFields-translatedUserPromptLabel");
                    });

                    $("#DTE_Field_useTokenLimits_0").on("change", updateTokenLimitsVisibility);

                    eventsBinded = true;
                }
                clearTokenUsageChart();
                if (action === "edit" && aiAssistantsDataTable.EDITOR.ids().length === 1) {
                    $("#tokenUsageTemplate").contents().clone().insertAfter(aiAssistantsDataTable.EDITOR.field("tokenLimit").node());
                }
                updateTokenLimitsVisibility();
                initInstructionsEnhancements();
            });

            aiAssistantsDataTable.EDITOR.on("opened", loadTokenUsageChart);
            aiAssistantsDataTable.EDITOR.on("close", clearTokenUsageChart);
            $(document).on("shown.bs.tab", "#pills-dt-datatableInit-tokenLimits-tab", loadTokenUsageChart);

            function updateTokenLimitsVisibility() {
                var enabled = $("#DTE_Field_useTokenLimits_0").is(":checked");
                var editor = aiAssistantsDataTable.EDITOR;
                if (enabled) {
                    editor.field("usedTokens").show();
                    editor.field("tokenLimit").show();
                } else {
                    editor.field("usedTokens").hide();
                    editor.field("tokenLimit").hide();
                    editor.field("tokenLimit").error("");
                }
                $("#DTE_Field_tokenLimit").prop("required", enabled);
                $("#tokenUsagePanel").toggleClass("d-none", !enabled);
                if (enabled) loadTokenUsageChart();
            }

            function clearTokenUsageChart() {
                if ($("#tokenUsagePanel").data("loading")) WJ.hideLoader();
                if (tokenUsageChart) ChartTools.destroyChart(tokenUsageChart);
                tokenUsageChart = null;
                $("#tokenUsagePanel").remove();
            }

            async function loadTokenUsageChart() {
                const panel = $("#tokenUsagePanel");
                if (!panel.is(":visible") || tokenUsageChart || panel.data("loading")) return;
                panel.data("loading", true);
                const chartContainer = panel.find(".amcharts");
                WJ.showLoader(null, "#tokenUsagePanel #graphsDiv");
                try {
                    const [, result] = await Promise.all([
                        window.initAmcharts(),
                        $.getJSON(url + "token-usage", {assistantId: aiAssistantsDataTable.EDITOR.currentJson.id})
                    ]);
                    if (!panel[0].isConnected) return;
                    const chartData = Object.entries(result).map(([day, tokens]) => ({
                        day: WJ.formatDate(Number(day)),
                        tokens
                    }));

                    chartContainer.show();
                    tokenUsageChart = new ChartTools.BarChartForm({
                        yAxeName: "day",
                        xAxeName: "tokens",
                        chartTitle: '[[\#{components.ai_assistants.token_usage.title}]]',
                        chartDivId: "ai-assistant-token-usage",
                        chartData,
                        horizontal: false,
                        colorScheme: "set_red",
                        colorByValue: true
                    });

                    await ChartTools.createAmchart(tokenUsageChart, true);
                    const chart = tokenUsageChart.chart;
                    chart.xAxes.getIndex(0).get("renderer").set("minGridDistance", 90);
                    chart.yAxes.getIndex(0).set("maxPrecision", 0);
                    chart.series.getIndex(0).columns.template.setAll({
                        focusable: true,
                        ariaLabel: "{day}: {tokens} [[\#{components.ai_assistants.stats.used_tokens}]]"
                    });
                } catch {
                    if (!panel[0].isConnected) return;
                    if (tokenUsageChart) ChartTools.destroyChart(tokenUsageChart);
                    tokenUsageChart = null;
                    chartContainer.hide();
                } finally {
                    panel.data("loading", false);
                    if (panel[0].isConnected) WJ.hideLoader();
                }
            }

            function initInstructionsEnhancements() {
                var textarea = document.getElementById("DTE_Field_instructions");
                var lines = WJ.initTextareaLineNumbers(textarea);
                if (!textarea || $(textarea).data("instructions-enhanced")) return;

                // Preserve the instructions editor's existing keyboard and wrapping shortcuts.
                $(textarea).on("keydown", function(event) {
                    if (event.key !== "Tab") return;
                    event.preventDefault();
                    var start = this.selectionStart;
                    var end = this.selectionEnd;
                    this.value = this.value.substring(0, start) + "\t" + this.value.substring(end);
                    this.selectionStart = this.selectionEnd = start + 1;
                    lines.refresh();
                });
                $(textarea).on("dblclick", function() {
                    $(this.parentElement).toggleClass("instructions-editor-wrapped");
                });
                $(textarea).data("instructions-enhanced", true);
            }

            function changeFieldsVisibility(provider, action) {
                $.ajax({
                    type: "GET",
                    url: url + "provider-fields",
                    data: {
                        "provider": provider,
                        "action": action
                    },
                    success: function(res)
                    {
                        var toShow = Object.values(res);

                        if("create" == action) {
                            hideOnCreate.forEach(function(fieldName) {
                                if(toShow.includes(fieldName)) {
                                    aiAssistantsDataTable.EDITOR.field(fieldName).show();
                                } else {
                                    aiAssistantsDataTable.EDITOR.field(fieldName).hide();
                                }
                            });
                        } else if("edit" == action) {
                            hideOnEdit.forEach(function(fieldName) {
                                if(toShow.includes(fieldName)) {
                                    aiAssistantsDataTable.EDITOR.field(fieldName).show();
                                } else {
                                    aiAssistantsDataTable.EDITOR.field(fieldName).hide();
                                }
                            });
                        }
                    },
                    error: function(xhr, ajaxOptions, thrownError) {

                    }
                });
            }

            function getTranslatedKey(keyToTranslate, fieldId) {
                if(keyToTranslate == undefined || keyToTranslate == null || keyToTranslate == "") return;

                $.ajax({
                    url: url + "translate-key",
                    method: "get",
                    contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                    data: { key: keyToTranslate },
                    success: function(response) {
                        $("#DTE_Field_" + fieldId).val(response);
                    }
                });
            }
        });

    style.
        .pg-ai-token-usage div.amcharts { isolation: isolate; }

        div.DTE_Field_Name_instructions label { display: none; }
        div.DTE_Field_Name_instructions .md-textarea-editor { height: 502px; }
        .DTE .DTE_Field .instructions-editor-wrapped > textarea { white-space: break-spaces; overflow-wrap: normal; }
        .instructions-editor-wrapped > .md-textarea-editor__lines { display: none; }

        label[for='DTE_Field_editorFields-translatedDescription'] { visibility: hidden; }
        div.DTE_Field_Name_editorFields\.translatedDescription div.form-group-tooltip { display: none; }

        label[for='DTE_Field_editorFields-translatedUserPromptLabel'] { visibility: hidden; }
        div.DTE_Field_Name_editorFields\.translatedUserPromptLabel div.form-group-tooltip { display: none; }

        tr.not-active td {
            color: var(--bs-danger) !important;
        }

        tr.not-active td div a {
            color: var(--bs-danger) !important;
        }

        tr.not-init td, tr.out-of-tokens td {
            color: var(--bs-warning) !important;
        }

        tr.not-init td div a, tr.out-of-tokens td div a {
            color: var(--bs-warning) !important;
        }

    div#tokenResetInfo.alert.alert-info.mb-3.mt-3.d-none(role="status")
        i.ti.ti-info-circle.me-2(aria-hidden="true")
        span

    template#tokenUsageTemplate
        section#tokenUsagePanel.pg-ai-token-usage.mt-3.mx-3.d-none
            div#graphsDiv.hide-while-loading
                div#ai-assistant-token-usage.amcharts

    table.datatableInit.table
