extends ../../partials/layout

block content

    script.
        const queryString = window.location.search;
        const urlParams = new URLSearchParams(queryString);
        const urlDirPath = urlParams.get('dirPath');
        const urlFileIndexerPerm = urlParams.get('fileIndexerPerm');

        let unusedFilesTable = null;
        let unusedFilesTaskId = null;
        let pendingUnusedFilesTaskId = null;
        let unusedFilesPollTimer = null;

        if(urlDirPath == undefined || urlDirPath == null || urlDirPath.length < 1) {
            window.location.replace("/404.jsp");
        } else {
            let folderPropertiesTable;
            let isIndexing = false;

            window.addEventListener("WJ.DTE.innerTableInitialized", function(event) {
                if (event.detail.conf.id == "DTE_Field_editorFields.unusedFiles" && unusedFilesTable == null) {
                    unusedFilesTable = event.detail.conf.datatable;

                    var buttonCounter = 1;
                    unusedFilesTable.button().add(buttonCounter++, {
                        text: '<i class="ti ti-line-scan"></i>',
                        action: function (e, dt, node) {
                            startUnusedFilesScan();
                        },
                        className: 'btn btn-warning buttons-unused-files-analyze',
                        attr: {
                            'title': '[[\#{elfinder.folder_prop.unused_files.start}]]',
                            'data-toggle': 'tooltip'
                        }
                    });

                    unusedFilesTable.button().add(buttonCounter++, {
                        text: '<i class="ti ti-recycle"></i>',
                        action: function (e, dt, node) {
                            deleteAllUnusedFiles();
                        },
                        className: 'btn btn-danger buttons-unused-files-delete-all',
                        attr: {
                            'title': '[[\#{elfinder.folder_prop.unused_files.delete_all}]]',
                            'data-toggle': 'tooltip'
                        }
                    });

                    $(unusedFilesTable.button(".buttons-remove").node())
                        .attr("title", "[[\#{elfinder.folder_prop.unused_files.delete_selected}]]")
                        .attr("data-toggle", "tooltip");

                    unusedFilesTable.EDITOR.on("submitSuccess.unusedFiles", function(e, json, data, action) {
                        if (action == "remove") {
                            window.setTimeout(updateUnusedFilesAfterDelete, 100);
                        }
                    });

                    initUnusedFilesTab();
                }
            });

            window.addEventListener("WJ.DT.executeAction", function(event) {
                if (unusedFilesTable != null && event.detail.action == "start_analyze" && event.detail.tableId == unusedFilesTable.DATA.id) {
                    unusedFilesTaskId = pendingUnusedFilesTaskId;
                    pendingUnusedFilesTaskId = null;
                    unusedFilesTable.setAjaxUrl("/admin/rest/elfinder/unused-files?taskId=");
                    clearUnusedFilesTable();
                    setUnusedFilesResultActionsVisible(false);
                    pollUnusedFilesStatus(true);
                }
            });

            window.addEventListener("WJ.DT.executeActionCancel", function(event) {
                if (unusedFilesTable != null && event.detail.action == "start_analyze" && event.detail.tableId == unusedFilesTable.DATA.id) {
                    setUnusedFilesBusy(false);
                    pendingUnusedFilesTaskId = null;
                    setUnusedFilesResultActionsVisible(unusedFilesTable.rows().any());
                    setUnusedFilesStatus("[[\#{elfinder.folder_prop.unused_files.start_failed}]]", "danger");
                }
            });

            window.domReady.add(function () {
                let url = '/admin/rest/elfinder/folder-properties';
                var columns = [(${layout.getDataTableColumns('sk.iway.iwcm.system.elfinder.FolderPropertiesEntity')})];
                let initIndexTab = false;

                var tabs = [
                    { id: 'basic', title: '[[\#{datatable.tab.basic}]]', selected: true },
                    { id: 'index', title: '[[\#{elfinder.folder_prop.index.tab}]]' },
                    { id: 'usage', title: '[[\#{elfinder.folder_prop.usage.tab}]]' },
                    { id: 'unusedFiles', title: '[[\#{elfinder.folder_prop.unused_files.tab}]]' }
                ];

                folderPropertiesTable = WJ.DataTable({
                    url: WJ.urlAddParam(url, "dir", urlDirPath),
                    columns: columns,
                    tabs: tabs,
                    serverSide: true,
                    fetchOnEdit: true,
                    fetchOnCreate: true
                });

                folderPropertiesTable.EDITOR.on( 'open', function ( e, data, action ) {
                    $("div.DTE_Header_Content").find("h5.modal-title").text( folderPropertiesTable.EDITOR.currentJson["dirUrl"] );

                    $("#pills-dt-datatableInit-unusedFiles-tab")
                        .off("click.unusedFilesMaximize")
                        .on("click.unusedFilesMaximize", function() {
                            $("div.DTE_Body_Content").removeClass('changed');
                            $(window.parent.document)
                                .find("#modalIframe button.btn.maximize:visible")
                                .first()
                                .trigger("click");
                        });

                    if(urlFileIndexerPerm == undefined || urlFileIndexerPerm == null) urlFileIndexerPerm = true;

                    //show/hide tab index
                    if( urlDirPath.startsWith("/files") && (urlFileIndexerPerm == true || urlFileIndexerPerm == "true")) {
                        $("#pills-dt-datatableInit-index-tab").on("click", function(e) {
                            addIndexMenu();
                            $("div.DTE_Body_Content").addClass('changed');

                            $("#pills-dt-datatableInit-basic-tab").on("click", function(e) {
                                $("div.DTE_Body_Content").removeClass('changed');
                            });

                            $("#pills-dt-datatableInit-usage-tab").on("click", function(e) {
                                $("div.DTE_Body_Content").removeClass('changed');
                            });

                        });
                    } else {
                        $("#pills-dt-datatableInit-index-tab").css("display", "none");
                    }
                });

                function addIndexMenu() {
                    if(initIndexTab == false) {
                        let panelBody = $("#pills-dt-datatableInit-index > div.panel-body");
                        panelBody.append("<div id='indexMenu'> <p> [[\#{elfinder.folder_prop.start_indexing.txt}]] </p> <button id='start-index-button' class='btn btn-primary' onClick='startIndexing()'> [[\#{elfinder.folder_prop.start_indexing.btn}]] </button> </div>");
                        initIndexTab = true;
                    }
                }
            });

            function initUnusedFilesTab() {
                let panelBody = $("#pills-dt-datatableInit-unusedFiles > div.panel-body");
                if (panelBody.find("#unused-files-menu").length > 0) return;

                panelBody.prepend(
                    "<div id='unused-files-menu' class='unused-files-menu form-group'>" +
                        "<p>[[\#{elfinder.folder_prop.unused_files.description}]]</p>" +
                        "<div id='unused-files-status' class='alert alert-info'>" +
                            "<div id='unused-files-status-message'>[[\#{elfinder.folder_prop.unused_files.not_started}]]</div>" +
                            "<div class='custom-control form-switch unused-files-subfolders'>" +
                                "<input id='unused-files-include-subfolders' class='form-check-input' type='checkbox' value='true'>" +
                                "<label class='form-check-label' for='unused-files-include-subfolders'>[[\#{elfinder.folder_prop.unused_files.include_subfolders}]]</label>" +
                            "</div>" +
                        "</div>" +
                    "</div>"
                );

                setUnusedFilesResultActionsVisible(false);
                loadLatestUnusedFilesTask();
            }

            function loadLatestUnusedFilesTask() {
                setUnusedFilesBusy(true);
                $.ajax({
                    url: "/admin/rest/elfinder/unused-files/latest",
                    data: { dir: urlDirPath },
                    success: function(data) {
                        if (data == null || data.taskId == null) {
                            setUnusedFilesBusy(false);
                            return;
                        }

                        unusedFilesTaskId = data.taskId;
                        $("#unused-files-include-subfolders").prop("checked", data.includeSubfolders === true);
                        pollUnusedFilesStatus(true);
                    },
                    error: function(xhr) {
                        setUnusedFilesBusy(false);
                        handleUnusedFilesRequestError(xhr);
                    }
                });
            }

            function startUnusedFilesScan() {
                stopUnusedFilesPolling();
                pendingUnusedFilesTaskId = generateUnusedFilesTaskId();
                setUnusedFilesBusy(true);
                setUnusedFilesStatus("[[\#{elfinder.folder_prop.unused_files.scanning}]]", "info");

                unusedFilesTable.executeAction(
                    "start_analyze",
                    true,
                    null,
                    null,
                    JSON.stringify({
                        taskId: pendingUnusedFilesTaskId,
                        dir: urlDirPath,
                        includeSubfolders: $("#unused-files-include-subfolders").is(":checked")
                    }),
                    -1
                );
            }

            function generateUnusedFilesTaskId() {
                if (window.crypto != null && typeof window.crypto.randomUUID == "function") {
                    return window.crypto.randomUUID();
                }
                return "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, function(character) {
                    let random = Math.random() * 16 | 0;
                    let value = character == "x" ? random : (random & 0x3 | 0x8);
                    return value.toString(16);
                });
            }

            function pollUnusedFilesStatus(loadResult) {
                if (unusedFilesTaskId == null) return;

                $.ajax({
                    url: "/admin/rest/elfinder/unused-files/status",
                    data: { taskId: unusedFilesTaskId },
                    success: function(data) {
                        if (data.error != null && data.error != "") {
                            stopUnusedFilesPolling();
                            setUnusedFilesBusy(false);
                            unusedFilesTaskId = null;
                            setUnusedFilesResultActionsVisible(false);
                            clearUnusedFilesTable();
                            setUnusedFilesStatus(data.error, "danger");
                            return;
                        }

                        if (data.state == "SCANNING") {
                            setUnusedFilesBusy(true);
                            setUnusedFilesStatus("[[\#{elfinder.folder_prop.unused_files.scanning}]]", "info");
                            scheduleUnusedFilesPoll(loadResult);
                        } else if (data.state == "READY") {
                            stopUnusedFilesPolling();
                            setUnusedFilesBusy(false);

                            if (data.totalFiles > 0) {
                                setUnusedFilesStatus(
                                    "[[\#{elfinder.folder_prop.unused_files.ready}]]".replace("{1}", data.totalFiles),
                                    "success"
                                );
                            } else {
                                setUnusedFilesStatus("[[\#{elfinder.folder_prop.unused_files.empty}]]", "success");
                            }

                            if (loadResult) loadUnusedFilesResult();
                        } else {
                            stopUnusedFilesPolling();
                            setUnusedFilesBusy(false);
                            setUnusedFilesResultActionsVisible(false);
                            clearUnusedFilesTable();
                            setUnusedFilesStatus("[[\#{elfinder.folder_prop.unused_files.failed}]]", "danger");
                        }
                    },
                    error: function(xhr) {
                        stopUnusedFilesPolling();
                        setUnusedFilesBusy(false);
                        handleUnusedFilesRequestError(xhr);
                    }
                });
            }

            function scheduleUnusedFilesPoll(loadResult) {
                stopUnusedFilesPolling();
                unusedFilesPollTimer = window.setTimeout(function() {
                    pollUnusedFilesStatus(loadResult);
                }, 2000);
            }

            function stopUnusedFilesPolling() {
                if (unusedFilesPollTimer != null) {
                    window.clearTimeout(unusedFilesPollTimer);
                    unusedFilesPollTimer = null;
                }
            }

            function loadUnusedFilesResult() {
                if (unusedFilesTable == null || unusedFilesTaskId == null) return;

                let resultUrl = WJ.urlAddParam(
                    "/admin/rest/elfinder/unused-files",
                    "taskId",
                    unusedFilesTaskId
                );
                unusedFilesTable.setAjaxUrl(resultUrl);
                unusedFilesTable.ajax.reload(function() {
                    updateUnusedFilesAfterDelete();
                });
            }

            function deleteAllUnusedFiles() {
                if (unusedFilesTable == null || unusedFilesTable.rows().any() == false) return;
                unusedFilesTable.rows().select();
                unusedFilesTable.button(".buttons-remove").trigger();
            }

            function updateUnusedFilesAfterDelete() {
                if (unusedFilesTable == null) return;

                let totalFiles = unusedFilesTable.rows().count();
                setUnusedFilesResultActionsVisible(totalFiles > 0);
                if (totalFiles > 0) {
                    setUnusedFilesStatus(
                        "[[\#{elfinder.folder_prop.unused_files.ready}]]".replace("{1}", totalFiles),
                        "success"
                    );
                } else {
                    setUnusedFilesStatus("[[\#{elfinder.folder_prop.unused_files.empty}]]", "success");
                }
            }

            function setUnusedFilesBusy(busy) {
                $("#unused-files-include-subfolders").prop("disabled", busy);
                if (unusedFilesTable == null) return;

                unusedFilesTable.button(".buttons-unused-files-analyze").enable(busy == false);
                unusedFilesTable.button(".buttons-unused-files-delete-all").enable(busy == false);

                let enableDeleteSelected = busy == false && unusedFilesTable.rows({ selected: true }).any();
                unusedFilesTable.button(".buttons-remove").enable(enableDeleteSelected);
            }

            function setUnusedFilesResultActionsVisible(visible) {
                if (unusedFilesTable == null) return;
                $("#" + unusedFilesTable.DATA.id + "_wrapper")
                    .find("button.buttons-remove, button.buttons-unused-files-delete-all")
                    .toggle(visible);
            }

            function clearUnusedFilesTable() {
                if (unusedFilesTable != null) {
                    unusedFilesTable.clear().draw();
                }
            }

            function setUnusedFilesStatus(message, type) {
                $("#unused-files-status")
                    .removeClass("alert-info alert-success alert-warning alert-danger")
                    .addClass("alert-" + type);
                $("#unused-files-status-message").text(message);
            }

            function handleUnusedFilesRequestError(xhr) {
                let message = "[[\#{elfinder.folder_prop.unused_files.failed}]]";
                if (xhr.status == 410) {
                    message = "[[\#{elfinder.folder_prop.unused_files.expired}]]";
                    unusedFilesTaskId = null;
                    setUnusedFilesResultActionsVisible(false);
                    clearUnusedFilesTable();
                } else if (unusedFilesTaskId == null) {
                    setUnusedFilesResultActionsVisible(false);
                }
                setUnusedFilesStatus(message, "danger");
            }

            function startIndexing() {
                $("div#indexMenu").css("display", "none");
                WJ.showLoader(null, "#pills-dt-datatableInit-index > div.panel-body");
                if(isIndexing == false) {
                    isIndexing = true;

                    //Add notification about running indexing
                    $("#pills-dt-datatableInit-index > div.panel-body").append("<strong> [[\#{findexer.indexing}]] </strong> <hr>");

                    $.ajax({
                        url: '/admin/rest/elfinder/folder-properties/fulltext-index?dir=' + urlDirPath,
                        success: function(data) {
                            WJ.hideLoader();
                            $("#pills-dt-datatableInit-index > div.panel-body").html("<div class='log'>"+data+"</div>");
                        }
                    });
                }
            }
            function openDocDetails(docId) {
                if(docId != undefined && docId != null && docId > 0) {
                    window.open("/admin/v9/webpages/web-pages-list/?docid=" + docId);
                }
            }
            function openFile(path) {
                if(path != undefined && path != null && path.length > 0) {
                    window.open(path);
                }
            }
        }

    style.
        .changed { text-align: center; padding: 10px; }
        .changed::before { background-color: transparent !important; }
        div.log {
            text-align: left;
            font-size: 14px;
        }
        .unused-files-menu {
            padding: 16px;
        }
        .unused-files-menu .alert {
            margin-bottom: 12px;
        }
        .unused-files-subfolders {
            display: flex;
            align-items: center;
            margin-top: 8px;
        }
        .unused-files-subfolders .form-check-input {
            margin-top: 0;
            margin-right: 8px;
        }
    <table id="folderPropertiesTable" class="datatableInit table"></table>
