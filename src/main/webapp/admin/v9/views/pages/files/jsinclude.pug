    /** Filters the native folder tree using the same controls as the gallery. */
    function initElfinderTreeSearch(finder) {
        const navbar = finder.getUI('navbar');
        if (!navbar.length || navbar.find('.elfinder-tree-search').length) return;
        const tree = finder.getUI('tree');
        const panel = $('<form class="elfinder-tree-search" aria-busy="false"></form>').prependTo(navbar);
        const id = finder.namespace + '-folder-search';
        const table = $('<table class="table datatableInit dataTable no-footer"><thead><tr><th class="elfinder-tree-search-label"></th></tr><tr><th class="dt-format-text"></th></tr></thead></table>').appendTo(panel);
        $('<label></label>').attr('for', id).text(WJ.translate('editor.directory_name')).appendTo(table.find('th').first());
        const group = $('<div class="input-group"></div>').appendTo(table.find('th').last());
        const type = $('<select class="filter-input-prepend"></select>').attr('aria-label', WJ.translate('datatables.select.type.js')).appendTo(group);
        const icons = ['arrows-horizontal', 'arrow-left-bar', 'arrow-right-bar', 'equal'];
        ['contains', 'startwith', 'endwith', 'equals'].forEach(function(value, index) {
            const label = WJ.translate('datatables.select.' + value + '.js');
            $('<option></option>').val(value).text(label)
                .attr('data-content', '<i class="ti ti-' + icons[index] + '" aria-hidden="true"></i><small>' + WJ.escapeHtml(label) + '</small>').appendTo(type);
        });
        const input = $('<input class="form-control form-control-sm filter-input" type="text">').attr('id', id).appendTo(group);
        const search = $('<button type="submit" class="btn btn-sm btn-outline-secondary btn-search"><i class="ti ti-search" aria-hidden="true"></i></button>')
            .attr('aria-label', WJ.translate('datatables.defaults.search.js')).appendTo(group);
        const clear = $('<button type="button" class="btn btn-sm btn-outline-secondary btn-clear"><i class="ti ti-circle-x" aria-hidden="true"></i></button>')
            .attr('aria-label', WJ.translate('button.reset')).appendTo(group);
        const status = $('<div role="status" class="elfinder-tree-search-status" hidden></div>').insertAfter(panel);
        let generation = 0;
        let visibleHashes = null;
        let matchingHashes = new Set();
        let expandedBeforeSearch = null;
        let enabledDropTargets = $();
        type.selectpicker({ container: 'body', style: 'btn btn-sm btn-outline-secondary', width: '100%' });

        function setSearching(searching) {
            if (searching && !tree.prop('inert')) {
                enabledDropTargets = tree.find('.ui-droppable:not(.ui-droppable-disabled)');
                enabledDropTargets.droppable('disable');
            } else if (!searching) {
                enabledDropTargets.filter('.ui-droppable').droppable('enable');
                enabledDropTargets = $();
            }
            search.prop('disabled', searching);
            panel.attr('aria-busy', String(searching));
            tree.prop('inert', searching).attr({ 'aria-busy': String(searching), 'aria-disabled': String(searching) });
        }

        function filterTree() {
            tree.find('.elfinder-navbar-dir').each(function() {
                const node = $(this);
                const hash = finder.navId2Hash(this.id);
                node.parent().toggleClass('elfinder-tree-search-hidden', visibleHashes !== null && !visibleHashes.has(hash));
                node.toggleClass('elfinder-tree-search-match', matchingHashes.has(hash));
            });
        }

        function reset() {
            generation++;
            input.val('');
            setSearching(false);
            status.prop('hidden', true);
            visibleHashes = null;
            matchingHashes.clear();
            filterTree();
            if (expandedBeforeSearch !== null) {
                // Keep the current directory visible when it changed while searching.
                finder.navHash2Elm(finder.cwd().hash).parents('.elfinder-navbar-subtree').prev('.elfinder-navbar-dir').each(function() {
                    expandedBeforeSearch.add(this.id);
                });
                tree.find('.elfinder-navbar-dir').each(function() {
                    const expanded = expandedBeforeSearch.has(this.id);
                    $(this).toggleClass('elfinder-navbar-expanded', expanded).next('.elfinder-navbar-subtree').toggle(expanded);
                });
                expandedBeforeSearch = null;
            }
            input.trigger('focus');
        }
        clear.on('click', reset);
        panel.on('keydown', function(event) {
            event.stopPropagation();
            if (event.key === 'Escape') { event.preventDefault(); reset(); }
        });
        panel.on('focusin', function() { finder.disable(); });
        input.on('input', function() { if (!input.val()) reset(); });
        panel.on('submit', async function(event) {
            event.preventDefault();
            event.stopPropagation();
            const query = input.val().trim();
            if (!query) { reset(); return; }
            const current = ++generation;
            const matchType = type.val();
            if (expandedBeforeSearch === null) {
                expandedBeforeSearch = new Set(tree.find('.elfinder-navbar-expanded').map(function() { return this.id; }).get());
            }
            status.text(WJ.translate('datatables.defaults.processing.js')).prop('hidden', false);
            setSearching(true);
            try {
                const folders = new Map();
                const matches = new Set();
                for (const target of Object.values(finder.roots)) {
                    const response = await finder.request({
                        data: { cmd: 'tree', target, treeSearchValue: query, treeSearchType: matchType },
                        preventDefault: true,
                        preventFail: true
                    });
                    if (current !== generation) return;
                    if (!Array.isArray(response.treeSearchMatches)) throw new Error('Folder search is unavailable');
                    (response.tree || []).forEach(folder => folders.set(folder.hash, folder));
                    response.treeSearchMatches.forEach(hash => matches.add(hash));
                }
                const dirs = Array.from(folders.values());
                finder.cache(dirs);
                finder.trigger('add', { added: dirs });
                visibleHashes = new Set(folders.keys());
                matchingHashes = matches;
                filterTree();
                matchingHashes.forEach(function(hash) {
                    finder.navHash2Elm(hash).parents('.elfinder-navbar-subtree').show()
                        .prev('.elfinder-navbar-dir').addClass('elfinder-navbar-expanded');
                });
                status.text(matches.size ? '' : finder.i18n('emptySearch')).prop('hidden', matches.size > 0);
            } catch (error) {
                if (current === generation) status.text(finder.i18n('errUnknown')).prop('hidden', false);
            } finally {
                if (current === generation) {
                    setSearching(false);
                }
            }
        });
        // Native navigation can load more nodes; keep unrelated siblings filtered out.
        const observer = new MutationObserver(filterTree);
        observer.observe(tree[0], { childList: true, subtree: true });
        finder.bind('destroy', function() { generation++; observer.disconnect(); });
    }

    function initElfinderFolderSearch(finder) {
        const template = document.getElementById('elfinder-empty-search');
        const input = finder.getUI('toolbar').find('input[name="wjsearch"]');
        if (!input.length) return;

        const placeholder = finder.i18n('wjSearchFolder');
        input.attr({ placeholder, 'aria-label': placeholder });
        const pane = finder.getUI('cwd').parent();
        const actions = $(template.content.firstElementChild.cloneNode(true)).appendTo(pane);
        const recursive = document.getElementById(finder.namespace + 'SearchFromCwdRecursive');
        const retry = actions.find('[data-action="subfolders"]').text(finder.i18n('wjSearchSubfolders'));
        const clear = actions.find('[data-action="clear"]').text(finder.i18n('wjSearchClear'));
        actions.find('[role="status"]').text(finder.i18n('wjSearchNoFiles'));

        clear.on('click', function() {
            finder.trigger('searchend');
            pane.trigger('focus');
        });
        retry.on('click', function() {
            input.val(finder.searchStatus.query);
            recursive.click();
        });
        finder.bind('searchstart', function() {
            retry.prop('hidden', !recursive || recursive.checked);
        });

        input.siblings('.ui-icon-close').attr({ role: 'button', tabindex: 0, 'aria-label': clear.text() })
            .on('keydown', function(event) {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    event.stopPropagation();
                    $(this).trigger('mousedown');
                    pane.trigger('focus');
                }
            });
    }

    /** Adds an upload prompt for empty folders while respecting volume and folder permissions. */
    function initElfinderEmptyFolder(finder) {
        const template = document.getElementById('elfinder-empty-folder');
        const prompt = $(template.content.firstElementChild.cloneNode(true)).appendTo(finder.getUI('cwd').parent());
        const hint = prompt.find('.elfinder-empty-folder-hint').text(finder.i18n('wjEmptyFolderUploadHint'));
        const button = prompt.find('[data-action="upload"]');
        prompt.find('[role="status"]').text(finder.i18n('emptyFolder'));
        button.find('span').text(finder.i18n('cmdupload'));

        const refresh = function() {
            const cwd = finder.cwd();
            const canUpload = Boolean(cwd && cwd.write && finder.isCommandEnabled('upload', cwd.hash));
            hint.prop('hidden', !canUpload);
            button.prop('hidden', !canUpload);
            return canUpload;
        };
        button.on('keydown keypress', function(event) {
            if (event.key === 'Enter' || event.key === ' ') {
                event.stopPropagation();
            }
        }).on('click', function(event) {
            event.stopPropagation();
            if (!refresh()) return;
            finder.enable();
            finder.exec('upload', [finder.cwd().hash]);
        });
        finder.bind('open reload sync change', refresh);
        refresh();
    }

    function setInitialElfinderHeight() {
        if (!elFinderInstance) return;

        const finder = elFinderInstance;
        const refreshToolbar = function() {
            showElfinderToolbarTab(finder, finder.getUI('toolbar').attr('data-elfinder-tab') || 'file');
        };
        finder.bind('toolbarload', refreshToolbar);
        refreshToolbar();
        initElfinderTooltips(finder);
        $(".elfinder-button").addClass("btn btn-sm");

        $(".elfinder-button").has(".elfinder-button-icon-cut").addClass("div-danger");
        $(".elfinder-button").has(".elfinder-button-icon-rm").addClass("div-danger");

        $(".elfinder-button").has(".elfinder-button-icon-upload").addClass("div-create");
        $(".elfinder-button").has(".elfinder-button-icon-mkdir").addClass("div-create");

        $(".elfinder-button").has(".elfinder-button-icon-duplicate").addClass("div-duplicate");

        $(".elfinder-button").has(".elfinder-button-icon-wjeditswitch").addClass("div-warning");

        //Make the drop zone focusable for accessibility
        $(".elfinder-cwd-wrapper").attr("tabindex", "0").attr("role", "region").attr("aria-label", "[[\#{datatables.upload.uploadFile.js}]]");

        // Let focused CMS tabs handle keys instead of elFinder's file shortcuts.
        $('#pills-tabsFilter, .tabbable-elfinder > .md-tabs').on('focusin', function() {
            elFinderInstance.disable();
        });

        initElfinderFolderSearch(elFinderInstance);
        initElfinderTreeSearch(elFinderInstance);
        initElfinderEmptyFolder(elFinderInstance);
        const pathBar = elFinderInstance.getUI().find('.elfinder-workzone-path');
        pathBar.find('.elfinder-path-roots .elfinder-button-icon').attr('class', 'ti ti-home').attr('aria-hidden', 'true');
        pathBar.find('.elfinder-path-roots').attr({ role: 'button', tabindex: 0, 'aria-label': elFinderInstance.i18n('volumeRoots') }).on('keydown', function(event) {
            if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                event.stopPropagation();
                const offset = $(this).offset();
                $(this).trigger($.Event('click', { pageX: offset.left, pageY: offset.top + $(this).outerHeight() }));
            }
        });
        if (pathBar.length && !pathBar.find('.elfinder-copy-button').length) {
            pathBar.append(elfinderCopyButton('wjCopyPath', elFinderInstance, () => elFinderInstance.path(elFinderInstance.cwd().hash, true)));
        }
        elFinderInstance.bind('contextmenucreatedone', function(event) {
            if (event.data.type !== 'files' || event.data.targets.length !== 1) return;
            const file = elFinderInstance.file(event.data.targets[0]);
            if (file) $('<div class="elfinder-contextmenu-header">').append($('<span>').text(file.i18 || file.name))
                .prependTo(elFinderInstance.getUI('contextmenu'));
        });
        setElfinderHeight();
        const observer = new ResizeObserver(setElfinderHeight);
        document.querySelectorAll('.ly-content, .tabbable-elfinder .md-tabs, #linkInput, div.innerPadding, #finder .elfinder-toolbar, #finder .elfinder-statusbar')
            .forEach(element => observer.observe(element));
    }

    function setElfinderHeight() {
        if ($('#fileArchive').is(':visible')) {
            $('#fileArchiveIframe').height(computeAvailableSpaceHeight() - 1);
        }
        if (elFinderInstance && $('#finder').is(':visible')) {
            elFinderInstance.resize('100%', computeAvailableSpaceHeight() - 1);
            // The toolbar can wrap without changing the outer height.
            elFinderInstance.trigger('uiresize');
        }
    }

    function computeAvailableSpaceHeight() {
        let tabsHeight = $(".tabbable-elfinder .md-tabs").outerHeight();
        if (typeof tabsHeight == "undefined") tabsHeight = 0;
        let availableSpace = parseInt( $(".ly-content").outerHeight() ) - parseInt( tabsHeight );

        //Can contain additional height
        let url =  window.location.href;
        if(url == undefined || url == null || url.length < 1) {
            return availableSpace;
        } else {
            let linkInput = $('#linkInput');
            if(linkInput !== undefined && linkInput !== null && linkInput.length > 0) {
                if(url.includes("hideLinkInput=true")) {
                    linkInput.hide();
                    return availableSpace;
                }

                if(url.includes("/dialog")) {
                     return ( availableSpace - parseInt( linkInput.outerHeight() ) );
                }
            }

            let innerPadding = $('div.innerPadding');
            if(innerPadding !== undefined && innerPadding !== null && innerPadding.length > 0) {
                if(url.includes("/wj_image") || url.includes("/wj_link")) {
                    return ( availableSpace - parseInt( innerPadding.innerHeight() ) );
                }
            }
        }

        //For index pug
        return availableSpace;
    }

    /** Fits CodeMirror to the dialog when it is opened, resized, maximized or restored. */
    function resizeElfinderDialog(textarea, editor)
    {
        var dialogContent = $(textarea).parent(),
            dialog = dialogContent.closest(".ui-dialog");
        var realWidth = $("#finder").width();
        var realHeight = $("#finder").height();
        dialog.css({
            height: realHeight * 0.8,
            width: realWidth * 0.9,
            left: realWidth * 0.05,
            top: 0
        });

        const resizeEditor = function() {
            let height = dialog.height();
            dialog.children(".ui-dialog-titlebar, .ui-dialog-buttonpane").each(function() {
                height -= $(this).outerHeight(true);
            });
            height -= dialogContent.outerHeight(true) - dialogContent.height();
            dialogContent.css("max-height", "none").height(Math.max(0, height));
            if (editor.getOption("fullScreen") == false) {
                editor.setSize("100%", "100%");
            }
        };
        dialog.off("resize.wjCodeMirror").on("resize.wjCodeMirror", resizeEditor);
        // Responsive admin layout changes can finish after elFinder's resize event.
        const observer = new ResizeObserver(resizeEditor);
        observer.observe(dialog[0]);
        dialog.on("remove.wjCodeMirror", function() {
            observer.disconnect();
        });
        resizeEditor();
    }

yield
