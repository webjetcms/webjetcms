script.
    elFinder.prototype._options.uiOptions.path.toWorkzone = true;
    elFinder.prototype._options.uiOptions.cwd.iconsView.preserveExtension = true;
    elFinder.prototype._options.handlers.dialogopen = function(event, finder) {
        const allowedTypes = finder.option('uploadMime').allow;
        const accept = Array.isArray(allowedTypes) ? allowedTypes.map(type => type.endsWith('/') ? type + '*' : type).join(',') : '';
        event.data.dialog.find('input[type=file]:not([directory])').attr('accept', accept);
        initElfinderInfo(event.data.dialog, finder);
    };

    /** Copies text on HTTPS and HTTP intranets, preserving the focused control. */
    async function copyElfinderText(value, button, finder) {
        const label = button.attr('aria-label');
        try {
            let copied = false;
            if (navigator.clipboard?.writeText) {
                try {
                    await navigator.clipboard.writeText(value);
                    copied = true;
                } catch (error) { /* Fall back to a temporary selection when clipboard access is denied. */ }
            }
            if (!copied) {
                const focused = document.activeElement;
                const input = $('<textarea readonly>').val(value).css({ position: 'fixed', top: 0, left: 0, opacity: 0 }).appendTo(button.closest('.elfinder'));
                try {
                    input[0].select();
                    if (!document.execCommand('copy')) throw new Error('Clipboard is unavailable');
                } finally {
                    input.remove();
                    focused?.focus({ preventScroll: true });
                }
            }
            button.attr({ title: finder.i18n('wjCopied'), 'aria-label': finder.i18n('wjCopied') }).find('i').attr('class', 'ti ti-check');
            setTimeout(function() {
                button.attr({ title: label, 'aria-label': label }).find('i').attr('class', 'ti ti-copy');
            }, 2000);
        } catch (error) {
            finder.error(finder.i18n('wjCopyFailed'));
        }
    }

    function elfinderCopyButton(key, finder, value) {
        return $('<button type="button" class="btn btn-sm btn-outline-secondary elfinder-copy-button"><i class="ti ti-copy" aria-hidden="true"></i></button>')
            .attr({ title: finder.i18n(key), 'aria-label': finder.i18n(key) })
            .on('click', function(event) {
                event.stopPropagation();
                copyElfinderText(value(), $(this), finder);
            });
    }

    function initElfinderInfo(dialog, finder) {
        if (!dialog.hasClass('elfinder-dialog-info') || dialog.data('wjInfoReady')) return;
        dialog.data('wjInfoReady', true);
        const table = dialog.find('.elfinder-info-tb');
        const hashes = table.find('.elfinder-info-hash').closest('tr');
        if (hashes.length) {
            const details = $('<details class="elfinder-info-technical">').insertAfter(table);
            $('<summary>').text(finder.i18n('wjTechnicalDetails')).appendTo(details);
            $('<table class="elfinder-info-tb">').append(hashes).appendTo(details);
        }
        // Observe links that are resolved asynchronously by the connector.
        const addCopyLinks = function() {
            table.find('a[href]').each(function() {
                const link = $(this);
                if (!link.siblings('.elfinder-copy-button').length) {
                    elfinderCopyButton('wjCopyLink', finder, () => this.href).insertAfter(link);
                }
            });
        };
        addCopyLinks();
        const observer = new MutationObserver(addCopyLinks);
        observer.observe(table[0], { childList: true, subtree: true });
        dialog.one('close', () => observer.disconnect());
    }

    //kompatibilita s novym jQuery, po aktualizacii elfindera sa moze zrusit
    var rxhtmlTag = '/<(?!area|br|col|embed|hr|img|input|link|meta|param)(([\w:-]+)[^>]*)\/>/gi';
    jQuery.extend( {
        htmlPrefilter: function( html ) {
            var fixedHtml = html.replace( rxhtmlTag, "<$1></$2>" );
            //if (html != fixedHtml) console.log("htmlPrefilter: ", html, "fixed=", fixedHtml);
            //else console.log("SAME: ", html);
            return fixedHtml;
        }
    });

