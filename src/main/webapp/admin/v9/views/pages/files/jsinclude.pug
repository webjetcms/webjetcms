    /** Uses WebJET tooltips throughout elFinder, initializing only hovered or focused elements. */
    function initElfinderTooltips(finder) {
        const root = finder.getUI();
        const elements = new Set();
        root.on('mouseenter.wjTooltips focusin.wjTooltips', '[title], [data-bs-original-title]', function(event) {
            // File names can have their own title inside a row with file metadata.
            if ($(event.target).closest('[title], [data-bs-original-title]')[0] !== this) return;
            $(this).parentsUntil(root, '[data-bs-original-title]').each(function() {
                bootstrap.Tooltip.getInstance(this)?.hide();
            });
            if (bootstrap.Tooltip.getInstance(this) || !this.getAttribute('title')) return;
            const element = $(this);
            if (element.hasClass('elfinder-button')) element.attr('aria-label', element.attr('title'));
            WJ.initTooltip(element);
            elements.add(this);
            // Replay the first interaction for Bootstrap's native event listeners.
            this.dispatchEvent(new Event(event.type === 'mouseenter' ? 'mouseover' : 'focusin', { bubbles: true }));
        });
        const observer = new MutationObserver(function(records) {
            records.forEach(record => {
                if (record.type !== 'attributes') return;
                const element = $(record.target);
                const title = element.attr('title');
                const tooltip = bootstrap.Tooltip.getInstance(record.target);
                if (title == null || !tooltip) return;
                element.attr('data-bs-original-title', title).removeAttr('title');
                if (element.hasClass('elfinder-button')) element.attr('aria-label', title);
                tooltip.setContent({ '.tooltip-inner': WJ.parseMarkdown(title, { removeLastBr: true }) });
            });
            elements.forEach(element => {
                if (!root[0].contains(element)) {
                    bootstrap.Tooltip.getInstance(element)?.dispose();
                    elements.delete(element);
                }
            });
        });
        observer.observe(root[0], { subtree: true, childList: true, attributes: true, attributeFilter: ['title'] });
        finder.bind('destroy', function() {
            observer.disconnect();
            root.off('.wjTooltips');
            elements.forEach(element => bootstrap.Tooltip.getInstance(element)?.dispose());
        });
    }

    /** Groups toolbar actions by purpose, including when elFinder rebuilds them for another volume. */
    function showElfinderToolbarTab(finder, name) {
        if (!finder) return;
        const toolbar = finder.getUI('toolbar').attr('data-elfinder-tab', name);
        const groups = toolbar.children('.elfinder-buttonset').addClass('dt-buttons');
        const fileGroups = groups.has('.elfinder-button-icon-upload, .elfinder-button-icon-mkdir, .elfinder-button-icon-cut, .elfinder-button-icon-copy, .elfinder-button-icon-paste');
        const viewGroup = groups.has('.elfinder-button-icon-reload, .elfinder-button-icon-view, .elfinder-button-icon-view-list, .elfinder-button-icon-sort').addClass('elfinder-buttonset-view');
        groups.hide();
        if (name === 'file') fileGroups.add(viewGroup).show();
        else if (name === 'tools') groups.not(fileGroups).show();
    }

    function elfinderTabClick(name)
    {
        $('#fileArchive').hide();
        showElfinderToolbarTab(elFinderInstance, name);
        if ("file"==name)
        {
            $("#finder").show();
            $("#pixabay").hide();
        }
        else if ("tools"==name)
        {
            $("#finder").show();
            $("#pixabay").hide();
        }
        else if ("pixabay"==name)
        {
            $("#finder").hide();
            $("#pixabay").show();
        }
        else if ("fileArchive"==name)
        {
            $("#finder, #pixabay").hide();
            $("#fileArchive").show();
            openFileArchive();
        }
        if (name === 'file' || name === 'tools') {
            // Restore file actions after the tab click reaches elFinder's outside-click handler.
            setTimeout(function() {
                if (elFinderInstance) elFinderInstance.enable();
            }, 0);
        }
    }

